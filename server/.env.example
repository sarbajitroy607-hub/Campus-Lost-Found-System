# Render provides PORT automatically. Leave it unset in production.
# PORT=3001

DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
DATABASE_NAME=campus_lf
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION_TTL=86400

# Required to avoid the insecure development defaults in seedAdmin.js.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRSTNAME=Campus
ADMIN_LASTNAME=Admin

# Comma-separated URLs allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
